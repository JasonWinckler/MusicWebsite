{
  "name": "musicwebsite",
  "version": "1.0.0",
  "description": "Static bilingual Jason Shadow singing, event hosting and voice website for Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static.js",
    "preview": "node scripts/serve-static.cjs",
    "test": "npm run test:browser",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "screenshots": "playwright test tests/visual.spec.js",
    "install:browsers": "playwright install chromium",
    "generate": "node scripts/render-pages.cjs && node scripts/secondary-pages.cjs",
    "predev": "npm run generate",
    "prebuild": "npm run generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "^7.0.5"
  }
}
